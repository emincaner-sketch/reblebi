{
  "id": "/app",
  "name": "Reblebi",
  "short_name": "Reblebi",
  "description": "Sosyal medya yönetim paneli: planlama, gelen kutusu, analitik ve reklamlar",
  "lang": "tr",
  "dir": "ltr",
  "start_url": "/app",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "standalone"
  ],
  "orientation": "any",
  "background_color": "#0B0D12",
  "theme_color": "#0B0D12",
  "categories": [
    "business",
    "productivity",
    "social"
  ],
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Yeni gönderi",
