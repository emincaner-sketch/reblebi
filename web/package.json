{
  "name": "@sosyalpilot/web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5500",
    "build": "tsx scripts/snapshot.ts && tsc -p tsconfig.json --noEmit && vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && tsx scripts/prerender.ts",
    "preview": "vite preview",
    "typecheck": "tsx scripts/snapshot.ts && tsc -p tsconfig.json --noEmit",
    "i18n:check": "tsx scripts/i18n-check.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@tanstack/react-query": "^5.66.0",
    "lucide-react": "^0.475.0",
    "pptxgenjs": "4.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.5",
    "simple-icons": "^16.33.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "vite": "^6.1.0"
  }
}
