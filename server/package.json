{
  "name": "@sosyalpilot/server",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "SosyalPilot API, zamanlayıcı, DM motoru ve MCP sunucusu",
  "main": "dist/api/main.js",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/api/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/api/main.js",
    "mcp": "tsx src/mcp/main.ts",
    "mcp:build": "node dist/mcp/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.80.0",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.0.1",
    "@fastify/multipart": "^9.0.3",
    "@fastify/static": "^8.1.1",
    "@modelcontextprotocol/sdk": "^1.17.0",
    "dotenv": "^16.4.7",
    "fastify": "^5.3.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3"
  }
}
