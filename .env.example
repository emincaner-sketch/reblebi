# ===== SosyalPilot ortam değişkenleri =====
# Bu dosyayı .env olarak kopyala ve doldur. Boş bırakılan platformlar panelde "yapılandırılmadı" görünür.
# Ayrıntılar: docs/KURULUM.md (platformlar) ve docs/YAYIN.md (sunucuya kurulum, satışa hazırlık)

# --- Uygulama ---
APP_NAME=SosyalPilot
API_PORT=4100
# Uygulamanın dışarıdan erişilen adresi. OAuth callback, webhook, medya ve MCP adresleri buradan türetilir.
# Üretimde https şart. Yerelde test için tünel adresi (cloudflared/ngrok) yazılabilir.
PUBLIC_URL=http://localhost:4100
# Panelin adresi. Üretimde PUBLIC_URL ile aynıdır; geliştirmede panel 5173 portunda çalışır.
APP_URL=http://localhost:5173
# En az 32 karakter rastgele gizli anahtar (oturum imzası + token şifreleme): openssl rand -hex 32
# DİKKAT: sonradan değiştirirsen bağlı tüm kanalların yeniden bağlanması gerekir.
APP_SECRET=degistir-bunu-en-az-32-karakterlik-rastgele-bir-anahtarla
# Veri klasörü (SQLite veritabanı, yüklenen medya, günlük yedekler)
DATA_DIR=./data
# Varsayılan zaman dilimi ve arayüz dili (tr | en). Her çalışma alanı kendi saat dilimini seçebilir.
TZ=Europe/Istanbul
DEFAULT_LOCALE=tr

# --- Docker + Caddy ile yayın (docker-compose.yml) ---
# Alan adı (https otomatik alınır). PUBLIC_URL ve APP_URL'yi https://<DOMAIN> yap.
DOMAIN=

# --- SaaS: kayıt, deneme süresi, yönetici ---
# open: herkes kaydolabilir | invite: sadece davetle | closed: yeni kayıt kapalı
# (İlk kaydolan kişi her durumda süper yönetici olur.)
SIGNUP_MODE=open
TRIAL_DAYS=14
TRIAL_PLAN=pro
# Kaydolunca otomatik süper yönetici olacak e-postalar (virgülle)
SUPERADMIN_EMAILS=
# true: kullanıcı e-postasını doğrulamadan giriş yapamaz (SMTP gerekir)
REQUIRE_EMAIL_VERIFICATION=false
# Yasal sayfalarda (gizlilik, şartlar, veri silme) görünen bilgiler
SUPPORT_EMAIL=
COMPANY_NAME=
COMPANY_ADDRESS=
# Plan fiyat ve limitlerini değiştirmek için (isteğe bağlı, JSON):
# PLANS_JSON={"pro":{"priceMonthly":24,"priceYearly":240},"agency":{"channels":40}}

# --- E-posta (doğrulama, şifre sıfırlama, davet, bildirim) ---
# Boşsa e-postalar gönderilmez, bağlantılar sunucu günlüğüne yazılır.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=SosyalPilot <no-reply@alanadin.com>

# --- Yapay zeka (içerik üretimi, AI DM yanıtı, plan kurma) ---
# Platform varsayılanı: anthropic | openai | xai | gemini | openrouter | custom
# Müşteriler Ayarlar > AI bölümünden kendi anahtarlarını da girebilir (Pro ve üstü planlar).
AI_PROVIDER=anthropic
# Boş bırakılırsa sağlayıcının varsayılan modeli kullanılır
AI_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
XAI_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
# OpenAI uyumlu herhangi bir uç nokta (custom)
AI_CUSTOM_BASE_URL=
AI_CUSTOM_API_KEY=
# Marka hafızası klasörü (isteğe bağlı). Boşsa paneldeki marka ayarları kullanılır.
# BRAND_MEMORY_DIR=../sistemler/marka-hafizasi/hafiza

# --- Güvenlik ---
# Panel dışında çerezli istek atmasına izin verilen ek kökenler (virgülle)
ALLOWED_ORIGINS=
RATE_LIMIT_PER_MINUTE=300

# --- Yedekleme (her gün DATA_DIR/backups altına) ---
BACKUP_ENABLED=true
BACKUP_KEEP=7

# --- Meta (Facebook Sayfası + Instagram + Messenger + Instagram DM + WhatsApp) ---
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v21.0
# Webhook doğrulaması için senin belirlediğin rastgele bir metin
META_WEBHOOK_VERIFY_TOKEN=sosyalpilot-verify

# --- Threads (Meta uygulaması içindeki Threads kullanım senaryosunun ayrı App ID/Secret'ı) ---
THREADS_APP_ID=
THREADS_APP_SECRET=

# --- X (Twitter) OAuth 2.0 ---
X_CLIENT_ID=
X_CLIENT_SECRET=

# --- LinkedIn ---
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Şirket sayfası paylaşımı için Community Management onayı aldıysan:
# LINKEDIN_SCOPES=openid profile w_member_social r_organization_social w_organization_social rw_organization_admin

# --- TikTok ---
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# --- YouTube (Google Cloud OAuth istemcisi) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Telegram ve WhatsApp panelden (bot token / Phone Number ID) bağlanır, ek değişken gerekmez.

# --- Yerel MCP köprüsü (sadece stdio destekleyen istemciler için, isteğe bağlı) ---
# SOSYALPILOT_API_URL=http://localhost:4100
# SOSYALPILOT_API_KEY=sp_...
