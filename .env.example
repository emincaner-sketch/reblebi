# ===== SosyalPilot ortam değişkenleri =====
# Bu dosyayı .env olarak kopyala ve doldur. Boş bırakılan sağlayıcılar panelde "yapılandırılmadı" görünür.

# --- Uygulama ---
API_PORT=4100
# Panelin dışarıdan erişilen adresi (OAuth callback + webhook + medya URL'leri için ŞART, https olmalı)
# Yerelde test: ngrok/cloudflared tüneli ile gelen https adresi. Sunucuda: https://alanadin.com
PUBLIC_URL=http://localhost:4100
# En az 32 karakter rastgele gizli anahtar (oturum imzası + token şifreleme). `openssl rand -hex 32`
APP_SECRET=degistir-bunu-en-az-32-karakterlik-rastgele-bir-anahtarla
# Veri klasörü (SQLite + medya)
DATA_DIR=./data
# Zaman dilimi (takvim ve çalışma saatleri)
TZ=Europe/Istanbul

# --- Claude (AI içerik + DM yanıt) ---
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5
# Marka hafızası klasörü (sistemler/marka-hafizasi/hafiza gibi). Boş ise paneldeki marka ayarları kullanılır.
BRAND_MEMORY_DIR=../sistemler/marka-hafizasi/hafiza

# --- Meta (Facebook Sayfa + Instagram + Messenger + Instagram DM + WhatsApp) ---
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v21.0
# Webhook doğrulama için senin belirlediğin rastgele bir metin
META_WEBHOOK_VERIFY_TOKEN=sosyalpilot-verify

# --- Threads (Meta app içindeki Threads use-case'inin ayrı App ID/Secret'ı) ---
THREADS_APP_ID=
THREADS_APP_SECRET=

# --- X (Twitter) OAuth 2.0 ---
X_CLIENT_ID=
X_CLIENT_SECRET=

# --- LinkedIn ---
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# --- TikTok ---
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# --- YouTube (Google Cloud OAuth istemcisi) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Telegram ve WhatsApp panelden (bot token / phone number id) bağlanır, env gerekmez.
